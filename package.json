{
  "name": "quokkify/allure-report-action",
  "version": "0.1.0",
  "private": true,
  "description": "Allure report action with TypeScript implementation",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc && node esbuild.config.mjs",
    "build:watch": "tsc -w",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:allure": "vitest run",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\"",
    "check": "npm run format:check && npm run lint && npm run test",
    "all": "npm run format && npm run lint && npm run test && npm run build",
    "package": "npm run build"
  },
  "keywords": [
    "github-action",
    "allure",
    "test-report",
    "typescript"
  ],
  "author": "quokkify",
  "license": "MIT",
  "dependencies": {
    "@actions/core": "3.0.1",
    "@actions/github": "9.1.1",
    "@octokit/core": "^7.0.0",
    "@octokit/plugin-paginate-rest": "^15.0.0",
    "@octokit/plugin-rest-endpoint-methods": "^18.0.0",
    "@octokit/rest": "^22.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.5.0",
    "@typescript-eslint/eslint-plugin": "^8.5.0",
    "@typescript-eslint/parser": "^8.5.0",
    "allure-vitest": "^3.0.6",
    "esbuild": "^0.25.0",
    "eslint": "^9.10.0",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-import": "^2.30.0",
    "prettier": "^3.3.3",
    "typescript": "^6.0.0",
    "typescript-eslint": "^8.68.0",
    "vitest": "^3.0.0"
  },
  "engines": {
    "node": ">=24"
  }
}
