{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>quokkify/renovate-presets//presets/base",
    "github>quokkify/renovate-presets//presets/github-actions/default"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^action\\.yml$/"],
      "matchStrings": [
        "(?m)^  allure-version:\\n(?:    [^\\n]*\\n)*?    default:\\s*[\\\"']?(?<currentValue>\\d+\\.\\d+\\.\\d+)[\\\"']?\\s*$"
      ],
      "datasourceTemplate": "npm",
      "depNameTemplate": "allure"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/.github/workflows/ci\\.yml$/"],
      "matchStrings": [
        "uses: quokkify/project-toolkit/.github/workflows/node-ci\\.yml@(?<currentValue>v?\\d+\\.\\d+\\.\\d+|[a-f0-9]{40})"
      ],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "quokkify/project-toolkit"
    }
  ],
  "packageRules": [
    {
      "description": "Disable competing updates inside template-owned workflows; project-toolkit owns those versions and delivers them through copier update.",
      "matchFileNames": [".github/workflows/codeql.yml", ".github/workflows/copier-update.yml", ".github/workflows/gitleaks.yml", ".github/workflows/release.yml", ".github/workflows/validate.yml"],
      "enabled": false
    }
  ]
}
