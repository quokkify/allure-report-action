{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["github>quokkify/renovate-presets//presets/github-actions/default"],
  "packageRules": [
    {
      "description": "Stay below TypeScript 7 until typescript-eslint supports it: @typescript-eslint/parser peers typescript <6.1.0, so npm install fails with ERESOLVE.",
      "matchPackageNames": ["typescript"],
      "allowedVersions": "<7"
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^action\\.yml$/"],
      "matchStrings": [
        "(?m)^  allure-version:\\n(?:    [^\\n]*\\n)*?    default:\\s*[\\\"']?(?<currentValue>\\d+\\.\\d+\\.\\d+)[\\\"']?\\s*$"
      ],
      "datasourceTemplate": "npm",
      "depNameTemplate": "allure"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/.github/workflows/ci\\.yml$/"],
      "matchStrings": [
        "uses: quokkify/ci-kit/.github/workflows/node-ci\\.yml@(?<currentValue>v?\\d+\\.\\d+\\.\\d+|[a-f0-9]{40})"
      ],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "quokkify/ci-kit"
    }
  ]
}
